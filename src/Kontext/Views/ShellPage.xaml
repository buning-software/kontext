<Page
    x:Class="Kontext.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Kontext.Views">

    <Grid>
        <views:SignInView
            Margin="24"
            ViewModel="{x:Bind ViewModel}"
            Visibility="{x:Bind ViewModel.ShowSignIn, Mode=OneWay}" />

        <views:WorkspaceView
            ControlHost="{x:Bind ControlHost}"
            ViewModel="{x:Bind ViewModel}"
            Visibility="{x:Bind ViewModel.ShowWorkspace, Mode=OneWay}" />
    </Grid>
</Page>
