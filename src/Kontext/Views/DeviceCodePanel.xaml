<UserControl
    x:Class="Kontext.Views.DeviceCodePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8">
        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.DeviceCodePrompt, Mode=OneWay}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock
                VerticalAlignment="Center"
                IsTextSelectionEnabled="True"
                Style="{StaticResource TitleLargeTextBlockStyle}"
                Text="{x:Bind ViewModel.UserCode, Mode=OneWay}" />
            <Button
                x:Name="CopyCodeButton"
                Margin="0,5,0,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Copy code to clipboard"
                Click="CopyCodeButton_Click"
                ToolTipService.ToolTip="Copy to clipboard">
                <FontIcon x:Name="CopyCodeIcon" FontSize="16" Glyph="&#xE8C8;" />
            </Button>
        </StackPanel>
        <HyperlinkButton
            Padding="0"
            Content="{x:Bind ViewModel.VerificationLinkText, Mode=OneWay}"
            NavigateUri="{x:Bind ViewModel.VerificationUrl, Mode=OneWay}" />
    </StackPanel>
</UserControl>
