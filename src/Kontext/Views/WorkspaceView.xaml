<UserControl
    x:Class="Kontext.Views.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Kontext.Views"
    xmlns:vm="using:Kontext.Presentation">

    <UserControl.Resources>
        <DataTemplate x:Key="GroupTemplate" x:DataType="vm:RepositoryGroupViewModel">
            <NavigationViewItem
                AutomationProperties.Name="{x:Bind Name}"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                MenuItemsSource="{x:Bind Items}"
                SelectsOnInvoked="False"
                ToolTipService.ToolTip="{x:Bind Name}"
                Visibility="{x:Bind IsVisible, Mode=OneWay}">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
            </NavigationViewItem>
        </DataTemplate>

        <DataTemplate x:Key="IssueTemplate" x:DataType="vm:IssueItemViewModel">
            <NavigationViewItem AutomationProperties.Name="{x:Bind Title}" ToolTipService.ToolTip="{x:Bind Title}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <views:IssueStatusBadge
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind StatusText, Mode=OneWay}"
                        Status="{x:Bind Status, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind NumberText}" />
                </Grid>
            </NavigationViewItem>
        </DataTemplate>

        <DataTemplate x:Key="GeneralTemplate" x:DataType="vm:GeneralSessionViewModel">
            <NavigationViewItem
                AutomationProperties.AutomationId="ClaudeEntry"
                AutomationProperties.Name="{x:Bind Title}"
                ToolTipService.ToolTip="Ask Claude something, not linked to an issue">
                <TextBlock VerticalAlignment="Center" Text="{x:Bind Title}" />
            </NavigationViewItem>
        </DataTemplate>

        <DataTemplate x:Key="SeparatorTemplate" x:DataType="vm:SidebarSeparator">
            <NavigationViewItemSeparator />
        </DataTemplate>

        <views:SidebarTemplateSelector
            x:Key="SidebarTemplateSelector"
            GeneralTemplate="{StaticResource GeneralTemplate}"
            GroupTemplate="{StaticResource GroupTemplate}"
            IssueTemplate="{StaticResource IssueTemplate}"
            SeparatorTemplate="{StaticResource SeparatorTemplate}" />
    </UserControl.Resources>

    <NavigationView
        x:Name="Navigation"
        AutomationProperties.AutomationId="Sidebar"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="True"
        ItemInvoked="Navigation_ItemInvoked"
        SelectionChanged="Navigation_SelectionChanged"
        MenuItemTemplateSelector="{StaticResource SidebarTemplateSelector}"
        MenuItemsSource="{x:Bind ViewModel.Workspace.MenuItems, Mode=OneWay}"
        OpenPaneLength="340"
        PaneDisplayMode="Left">

        <NavigationView.AutoSuggestBox>
            <AutoSuggestBox
                AutomationProperties.AutomationId="SearchBox"
                AutomationProperties.Name="Search issues"
                PlaceholderText="Search issues"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.Workspace.Sidebar.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </NavigationView.AutoSuggestBox>

        <NavigationView.PaneCustomContent>
            <StackPanel Margin="16,4" Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            AutomationProperties.AutomationId="IssueCount"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Workspace.Sidebar.CountText, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Signing in…"
                            Visibility="{x:Bind ViewModel.IsStarting, Mode=OneWay}" />
                        <!-- While starting, the large ring in the content pane is the one loading indicator. -->
                        <ProgressRing
                            Width="14"
                            Height="14"
                            IsActive="{x:Bind views:VisibilityFormat.AndNot(ViewModel.Workspace.Sidebar.IsLoading, ViewModel.IsStarting), Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            Padding="8,4"
                            AutomationProperties.AutomationId="FilterButton"
                            AutomationProperties.Name="Filter repositories"
                            ToolTipService.ToolTip="Filter repositories">
                            <Grid>
                                <FontIcon FontSize="14" Glyph="&#xE71C;" />
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Margin="0,-4,-6,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind ViewModel.Workspace.Sidebar.IsFilterActive, Mode=OneWay}" />
                            </Grid>
                            <Button.Flyout>
                                <!-- Windowed popup: the terminal is a native child window and would otherwise cover the flyout. -->
                                <Flyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                                    <StackPanel MinWidth="220" Spacing="4">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Show repositories" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="No repositories"
                                            Visibility="{x:Bind ViewModel.Workspace.Sidebar.HasNoRepositoryFilters, Mode=OneWay}" />
                                        <!-- One card per account; its header checkbox shows or hides all of the account's repositories. -->
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Workspace.Sidebar.RepositoryAccounts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RepositoryAccountFilterViewModel">
                                                    <Border
                                                        Margin="0,4"
                                                        Padding="10,6,10,8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                        <StackPanel>
                                                            <CheckBox
                                                                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                                                IsChecked="{x:Bind AreAllVisible, Mode=TwoWay}"
                                                                ToolTipService.ToolTip="Show or hide all repositories of this account">
                                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title, Mode=OneWay}" />
                                                            </CheckBox>
                                                            <Rectangle
                                                                Height="1"
                                                                Margin="0,4"
                                                                HorizontalAlignment="Stretch"
                                                                Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                                            <ItemsControl ItemsSource="{x:Bind Repositories}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:RepositoryFilterItemViewModel">
                                                                        <CheckBox
                                                                            AutomationProperties.Name="{x:Bind Name}"
                                                                            Content="{x:Bind DisplayName}"
                                                                            IsChecked="{x:Bind IsVisible, Mode=TwoWay}"
                                                                            ToolTipService.ToolTip="{x:Bind Name}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.AutomationId="ClearFiltersButton"
                                            Command="{x:Bind ViewModel.Workspace.Sidebar.ClearFiltersCommand}"
                                            Content="Clear filters"
                                            Visibility="{x:Bind ViewModel.Workspace.Sidebar.IsFilterActive, Mode=OneWay}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            Padding="8,4"
                            AutomationProperties.AutomationId="RefreshButton"
                            AutomationProperties.Name="Refresh"
                            IsEnabled="{x:Bind views:VisibilityFormat.Not(ViewModel.IsStarting), Mode=OneWay}"
                            Command="{x:Bind ViewModel.Workspace.Sidebar.RefreshCommand}"
                            ToolTipService.ToolTip="Refresh">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No open issues"
                    Visibility="{x:Bind ViewModel.Workspace.Sidebar.IsEmpty, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="All repositories are hidden"
                    Visibility="{x:Bind ViewModel.Workspace.Sidebar.IsEverythingHidden, Mode=OneWay}" />
            </StackPanel>
        </NavigationView.PaneCustomContent>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Visibility="{x:Bind ViewModel.IsStarting, Mode=OneWay}">
                <Image
                    Width="96"
                    Height="96"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/Kontext.png" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Signing in…" />
            </StackPanel>
            <!-- Outside the stack so the logo and text sit exactly where "Select an issue" will. -->
            <ProgressRing
                Width="32"
                Height="32"
                Margin="0,200,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsStarting, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsStarting, Mode=OneWay}" />
            <views:IssueDetailView
                ControlHost="{x:Bind ControlHost, Mode=OneWay}"
                ViewModel="{x:Bind ViewModel.Workspace.Detail}"
                Visibility="{x:Bind views:VisibilityFormat.VisibleWhenNot(ViewModel.Workspace.IsDetailVisible, ViewModel.IsStarting), Mode=OneWay}" />
            <views:SignInView
                Padding="24"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                ViewModel="{x:Bind ViewModel}"
                Visibility="{x:Bind views:VisibilityFormat.VisibleWhen(ViewModel.ShowSignIn, ViewModel.Workspace.IsDetailVisible), Mode=OneWay}" />
            <views:GeneralSessionView
                ControlHost="{x:Bind ControlHost, Mode=OneWay}"
                ViewModel="{x:Bind ViewModel.Workspace.General}"
                Visibility="{x:Bind ViewModel.Workspace.IsGeneralOpen, Mode=OneWay}" />
            <views:SettingsView
                ViewModel="{x:Bind ViewModel}"
                Visibility="{x:Bind ViewModel.Workspace.IsSettingsOpen, Mode=OneWay}" />

            <InfoBar
                Grid.Row="1"
                AutomationProperties.AutomationId="ErrorBar"
                AutomationProperties.Name="{x:Bind ViewModel.Workspace.Errors.Message, Mode=OneWay}"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.Workspace.Errors.IsOpen, Mode=TwoWay}"
                Severity="Error">
                <StackPanel Margin="0,0,0,12" Spacing="8">
                    <TextBlock
                        AutomationProperties.AutomationId="ErrorMessage"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.Workspace.Errors.Message, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <ToggleButton
                        Visibility="{x:Bind ViewModel.Workspace.Errors.HasDetails, Mode=OneWay}"
                        AutomationProperties.AutomationId="ErrorDetailsToggle"
                        Content="Details"
                        IsChecked="{x:Bind ViewModel.Workspace.Errors.IsDetailsOpen, Mode=TwoWay}" />
                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.Workspace.Errors.IsDetailsOpen, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            MaxHeight="160"
                            AcceptsReturn="True"
                            AutomationProperties.AutomationId="ErrorDetails"
                            AutomationProperties.Name="Error details"
                            FontFamily="Consolas"
                            IsReadOnly="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{x:Bind ViewModel.Workspace.Errors.Details, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            AutomationProperties.AutomationId="ErrorDetailsCopy"
                            Click="CopyDetails_Click"
                            Content="Copy" />
                    </Grid>
                </StackPanel>
            </InfoBar>
        </Grid>
    </NavigationView>
</UserControl>
