<UserControl
    x:Class="Kontext.Views.GitChangesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:Kontext.Domain"
    xmlns:views="using:Kontext.Views"
    xmlns:vm="using:Kontext.Presentation">

    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#3A2EA043" />
                <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#3AF85149" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#302EA043" />
                <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#30F85149" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <!-- Every layer of the unified diff (numbers, signs, text, row colours) uses this line height so they line up. -->
        <x:Double x:Key="DiffLineHeight">19</x:Double>

        <Style x:Key="DiffGutterStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="44" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="LineHeight" Value="{StaticResource DiffLineHeight}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="DiffRowStyle" TargetType="Border">
            <Setter Property="Height" Value="{StaticResource DiffLineHeight}" />
        </Style>
        <Style x:Key="DiffAddedRowStyle" BasedOn="{StaticResource DiffRowStyle}" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource DiffAddedBackgroundBrush}" />
        </Style>
        <Style x:Key="DiffRemovedRowStyle" BasedOn="{StaticResource DiffRowStyle}" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource DiffRemovedBackgroundBrush}" />
        </Style>
        <Style x:Key="DiffHunkRowStyle" BasedOn="{StaticResource DiffRowStyle}" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="DiffCodeStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>

        <Style x:Key="DiffSignStyle" BasedOn="{StaticResource DiffCodeStyle}" TargetType="TextBlock">
            <Setter Property="Width" Value="12" />
            <Setter Property="IsTextSelectionEnabled" Value="False" />
            <Setter Property="LineHeight" Value="{StaticResource DiffLineHeight}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style
            x:Key="GitHeaderItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style
            x:Key="GitFileItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <DataTemplate x:Key="GitHeaderTemplate" x:DataType="vm:GitChangeRow">
            <TextBlock
                Margin="12,10,12,4"
                AutomationProperties.HeadingLevel="Level2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Text}" />
        </DataTemplate>

        <DataTemplate x:Key="GitFileTemplate" x:DataType="vm:GitChangeRow">
            <Grid AutomationProperties.Name="{x:Bind Text}" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="GitFileCheck"
                    AutomationProperties.Name="{x:Bind Text}"
                    IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Text="{x:Bind StatusGlyph}"
                        Visibility="{x:Bind IsAddedGlyph}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="{x:Bind StatusGlyph}"
                        Visibility="{x:Bind IsChangedGlyph}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind StatusGlyph}"
                        Visibility="{x:Bind IsRemovedGlyph}" />
                </Grid>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Text}">
                    <Run Text="{x:Bind FileName}" />
                    <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Folder}" />
                </TextBlock>
                <StackPanel
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind HasCounts}">
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind AdditionsText}" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind DeletionsText}" />
                </StackPanel>
            </Grid>
        </DataTemplate>





        <Style x:Key="DiffWrappedCodeStyle" BasedOn="{StaticResource DiffCodeStyle}" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <DataTemplate x:Key="SplitAddedCellTemplate" x:DataType="vm:SplitCell">
            <Grid
                Padding="8,0"
                Background="{ThemeResource DiffAddedBackgroundBrush}"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource DiffGutterStyle}" Text="{x:Bind views:GitViewFormat.Number(Number)}" />
                <TextBlock Grid.Column="1" Style="{StaticResource DiffSignStyle}" Text="+" />
                <TextBlock Grid.Column="2" Style="{StaticResource DiffWrappedCodeStyle}" Text="{x:Bind Text}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SplitRemovedCellTemplate" x:DataType="vm:SplitCell">
            <Grid
                Padding="8,0"
                Background="{ThemeResource DiffRemovedBackgroundBrush}"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource DiffGutterStyle}" Text="{x:Bind views:GitViewFormat.Number(Number)}" />
                <TextBlock Grid.Column="1" Style="{StaticResource DiffSignStyle}" Text="&#x2212;" />
                <TextBlock Grid.Column="2" Style="{StaticResource DiffWrappedCodeStyle}" Text="{x:Bind Text}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SplitContextCellTemplate" x:DataType="vm:SplitCell">
            <Grid Padding="8,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource DiffGutterStyle}" Text="{x:Bind views:GitViewFormat.Number(Number)}" />
                <TextBlock Grid.Column="1" Style="{StaticResource DiffSignStyle}" Text=" " />
                <TextBlock Grid.Column="2" Style="{StaticResource DiffWrappedCodeStyle}" Text="{x:Bind Text}" />
            </Grid>
        </DataTemplate>

        <views:SplitCellTemplateSelector
            x:Key="SplitCellTemplateSelector"
            AddedTemplate="{StaticResource SplitAddedCellTemplate}"
            ContextTemplate="{StaticResource SplitContextCellTemplate}"
            RemovedTemplate="{StaticResource SplitRemovedCellTemplate}" />

        <DataTemplate x:Key="SplitPairTemplate" x:DataType="vm:SplitDiffRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    Content="{x:Bind Left}"
                    ContentTemplateSelector="{StaticResource SplitCellTemplateSelector}"
                    IsTabStop="False" />
                <Border Grid.Column="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                <ContentControl
                    Grid.Column="2"
                    HorizontalContentAlignment="Stretch"
                    Content="{x:Bind Right}"
                    ContentTemplateSelector="{StaticResource SplitCellTemplateSelector}"
                    IsTabStop="False" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SplitSpanTemplate" x:DataType="vm:SplitDiffRow">
            <Grid Padding="8,2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource DiffWrappedCodeStyle}"
                    Text="{x:Bind Spanning.Text}" />
            </Grid>
        </DataTemplate>

        <views:SplitRowTemplateSelector
            x:Key="SplitRowTemplateSelector"
            PairTemplate="{StaticResource SplitPairTemplate}"
            SpanTemplate="{StaticResource SplitSpanTemplate}" />

        <views:GitRowTemplateSelector
            x:Key="GitRowTemplateSelector"
            FileTemplate="{StaticResource GitFileTemplate}"
            HeaderTemplate="{StaticResource GitHeaderTemplate}" />

        <views:GitRowStyleSelector
            x:Key="GitRowStyleSelector"
            FileStyle="{StaticResource GitFileItemStyle}"
            HeaderStyle="{StaticResource GitHeaderItemStyle}" />

      </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="96" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="1"
                Margin="12,4,12,0"
                Orientation="Horizontal"
                Spacing="4"
                Visibility="{x:Bind views:GitViewFormat.VisibleWhenText(ViewModel.Summary), Mode=OneWay}">
                <CheckBox
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="GitSelectAll"
                    AutomationProperties.Name="Select all files"
                    IsChecked="{x:Bind ViewModel.AllChecked, Mode=TwoWay}"
                    IsEnabled="{x:Bind views:VisibilityFormat.Not(ViewModel.IsBusy), Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
            </StackPanel>
            <ListView
                x:Name="FileList"
                Grid.Row="2"
                AutomationProperties.Name="Changed files"
                ItemContainerStyleSelector="{StaticResource GitRowStyleSelector}"
                ItemTemplateSelector="{StaticResource GitRowTemplateSelector}"
                SelectionChanged="FileList_SelectionChanged"
                SelectionMode="Single" />

            <StackPanel
                Grid.Row="3"
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Spacing="8">
                <TextBlock
                    AutomationProperties.AutomationId="GitStatusMessage"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind views:GitViewFormat.VisibleWhenText(ViewModel.StatusMessage), Mode=OneWay}" />
                <TextBox
                    MinHeight="56"
                    AcceptsReturn="True"
                    AutomationProperties.AutomationId="GitCommitMessage"
                    AutomationProperties.Name="Commit message"
                    IsEnabled="{x:Bind views:VisibilityFormat.Not(ViewModel.IsBusy), Mode=OneWay}"
                    PlaceholderText="Commit message"
                    Text="{x:Bind ViewModel.CommitMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="CommitButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="GitCommitButton"
                        Command="{x:Bind ViewModel.CommitCommand, Mode=OneWay}"
                        Content="{x:Bind views:GitViewFormat.CommitLabel(ViewModel.BusyText), Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                    </Button>
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="GitPushButton"
                        Command="{x:Bind ViewModel.PushCommand, Mode=OneWay}"
                        Content="{x:Bind views:GitViewFormat.PushLabel(ViewModel.UnpushedCount, ViewModel.BusyText), Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Padding="12,8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{x:Bind views:VisibilityFormat.VisibleWhen(ViewModel.HasSelectedChange), Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind views:GitViewFormat.Title(ViewModel.SelectedChange), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedDiff.Notice, Mode=OneWay}"
                            Visibility="{x:Bind views:GitViewFormat.VisibleWhenText(ViewModel.SelectedDiff.Notice), Mode=OneWay}" />
                    </StackPanel>
                    <SelectorBar
                        x:Name="LayoutBar"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Diff layout"
                        SelectionChanged="LayoutBar_SelectionChanged">
                        <SelectorBarItem
                            x:Name="UnifiedItem"
                            IsSelected="True"
                            Text="Unified"
                            ToolTipService.ToolTip="Show the changes in one column" />
                        <SelectorBarItem
                            x:Name="SplitItem"
                            Text="Split"
                            ToolTipService.ToolTip="Show the old and new text side by side" />
                    </SelectorBar>
                </Grid>
            </Border>

            <!--
                The unified diff is one RichTextBlock so a selection can run across lines, starting and ending anywhere.
                The line numbers and signs are separate, unselectable columns, and the row colours a layer behind them;
                every layer uses the same fixed line height so they stay aligned. Built in code from the diff lines.
            -->
            <ScrollViewer
                x:Name="DiffScroller"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                SizeChanged="DiffScroller_SizeChanged"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind views:VisibilityFormat.VisibleWhenNot(ViewModel.HasSelectedChange, ViewModel.IsSplitView), Mode=OneWay}">
                <Grid x:Name="DiffContent">
                    <StackPanel x:Name="DiffBackgrounds" />
                    <Grid Padding="8,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DiffOldNumbers" Style="{StaticResource DiffGutterStyle}" />
                        <TextBlock
                            x:Name="DiffNewNumbers"
                            Grid.Column="1"
                            Style="{StaticResource DiffGutterStyle}" />
                        <TextBlock
                            x:Name="DiffSigns"
                            Grid.Column="2"
                            Style="{StaticResource DiffSignStyle}" />
                        <RichTextBlock
                            x:Name="DiffText"
                            Grid.Column="3"
                            AutomationProperties.Name="Diff"
                            FontFamily="Consolas"
                            FontSize="13"
                            IsTextSelectionEnabled="True"
                            LineHeight="{StaticResource DiffLineHeight}"
                            LineStackingStrategy="BlockLineHeight"
                            TextWrapping="NoWrap" />
                    </Grid>
                </Grid>
            </ScrollViewer>

            <ScrollViewer
                x:Name="SplitScroller"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind views:VisibilityFormat.VisibleWhen(ViewModel.HasSelectedChange, ViewModel.IsSplitView), Mode=OneWay}">
                <ItemsRepeater
                    ItemTemplate="{StaticResource SplitRowTemplateSelector}"
                    ItemsSource="{x:Bind ViewModel.SplitRows, Mode=OneWay}" />
            </ScrollViewer>

            <TextBlock
                Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No uncommitted changes"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
            <TextBlock
                Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Select a file"
                Visibility="{x:Bind ViewModel.NeedsSelection, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
