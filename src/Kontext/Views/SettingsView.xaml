<UserControl
    x:Class="Kontext.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Kontext.Views">

    <UserControl.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>

        <Style x:Key="SettingsDescriptionStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100*" MaxWidth="1000" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="1"
                Padding="36,24"
                Spacing="24">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings" />

                <StackPanel Spacing="4">
                    <TextBlock
                        Margin="1,0,0,4"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Account" />

                    <InfoBar
                        Margin="0,0,0,4"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="Error" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid VerticalAlignment="Center" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="20"
                                Glyph="&#xE77B;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="GitHub account" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="{x:Bind ViewModel.GitHubStatusText, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                MinWidth="90"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Sign out of GitHub"
                                Command="{x:Bind ViewModel.SignOutCommand}"
                                Content="Sign out"
                                Visibility="{x:Bind ViewModel.HasGitHubAccount, Mode=OneWay}" />
                            <Button
                                Grid.Column="2"
                                MinWidth="90"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Sign in with GitHub"
                                Command="{x:Bind ViewModel.SignInCommand}"
                                Content="Sign in"
                                Visibility="{x:Bind ViewModel.HasNoGitHubAccount, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid VerticalAlignment="Center" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="20"
                                Glyph="&#xE774;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="GitHub Enterprise account" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="{x:Bind ViewModel.EnterpriseStatusText, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                MinWidth="90"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Sign out of GitHub Enterprise"
                                Command="{x:Bind ViewModel.SignOutEnterpriseCommand}"
                                Content="Sign out"
                                Visibility="{x:Bind ViewModel.HasEnterpriseAccount, Mode=OneWay}" />
                            <Button
                                Grid.Column="2"
                                MinWidth="90"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Sign in with GitHub Enterprise"
                                Command="{x:Bind ViewModel.SignInEnterpriseCommand}"
                                Content="Sign in"
                                Visibility="{x:Bind ViewModel.HasNoEnterpriseAccount, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                        <Grid VerticalAlignment="Center" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <views:DeviceCodePanel ViewModel="{x:Bind ViewModel, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasDeviceCode, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.CancelSignInCommand}"
                                Content="Cancel" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock
                        Margin="1,0,0,4"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="General" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid VerticalAlignment="Center" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="20"
                                Glyph="&#xE7E8;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Launch on startup" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Start Kontext when you sign in to Windows" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="LaunchOnStartupToggle"
                                Grid.Column="2"
                                MinWidth="0"
                                Margin="0,0,-12,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Launch on startup"
                                IsOn="{x:Bind ViewModel.LaunchOnStartup, Mode=OneWay}"
                                OffContent="{x:Null}"
                                OnContent="{x:Null}"
                                Toggled="OnLaunchOnStartupToggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid VerticalAlignment="Center" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="20"
                                Glyph="&#xE74D;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Clean up closed issues automatically" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Clear the session, worktree and branch of a closed issue in the background, unless it has uncommitted changes or unpushed commits" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                Margin="0,0,-12,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Clean up closed issues automatically"
                                IsOn="{x:Bind ViewModel.CleanUpAutomatically, Mode=TwoWay}"
                                OffContent="{x:Null}"
                                OnContent="{x:Null}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock
                        Margin="1,0,0,4"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="About" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid VerticalAlignment="Center" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="20"
                                Glyph="&#xE946;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Kontext" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="{x:Bind AppVersion}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
