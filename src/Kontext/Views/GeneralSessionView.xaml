<UserControl
    x:Class="Kontext.Views.GeneralSessionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:terminal="using:Kontext.Terminal">

    <Grid Padding="32,24,32,16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <terminal:TerminalSurface
                AutomationProperties.AutomationId="GeneralTerminal"
                ControlHost="{x:Bind ControlHost, Mode=OneWay}"
                Session="{x:Bind ViewModel.VisibleSession, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasSession, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Placeholder, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasNoSession, Mode=OneWay}" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,8,0,0"
            Padding="12,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{x:Bind ViewModel.HasEnded, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.EndedText, Mode=OneWay}" />
                <HyperlinkButton
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Start new session"
                    Command="{x:Bind ViewModel.StartNewSessionCommand}"
                    Content="Start new session" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
